# Server Configuration
PORT=3000
NODE_ENV=development

# Codex / OpenAI Configuration
# OPENAI_API_KEY is REQUIRED. The container's entrypoint runs
#   `codex login --with-api-key` once at startup using this key.
OPENAI_API_KEY=your_openai_api_key_here

# Directory Codex CLI runs in (where it sees your Swagger / OpenAPI specs).
# Absolute path, or relative to the app root. Default: ./resources/contexts
# CONTEXT_DIR=./resources/contexts

CODEX_MAX_TOKENS=4000
CODEX_TEMPERATURE=0.7

# Webhook Configuration
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=info

# Workflow Exposure (optional, comma-separated allowlist; empty = all)
WORKFLOWS_ENABLED=

# Security
# AUTH_MODE: none | api-key | oidc
#   unset  -> api-key when API_KEY is set, otherwise open (legacy behavior)
#   oidc   -> company SSO; requires the OIDC_* and PUBLIC_BASE_URL vars below
AUTH_MODE=
API_KEY=your_api_key_here
CORS_ORIGIN=http://localhost:3000

# --- OIDC (AUTH_MODE=oidc only) ---
# Issuer URL of your identity provider (Okta, Entra ID, Google, Keycloak...).
# Discovery runs at boot; the server exits if this is misconfigured.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Public URL of this deployment; the IdP redirect URI becomes <PUBLIC_BASE_URL>/auth/callback
PUBLIC_BASE_URL=
# Scopes requested at login (default: openid profile email)
OIDC_SCOPES=
# true -> forward each logged-in user's access token as the downstream API's
# Authorization header (your REST API must accept tokens from the same IdP)
OIDC_FORWARD_ACCESS_TOKEN=false
# Login session lifetime in hours (default 8; capped to the token lifetime
# when OIDC_FORWARD_ACCESS_TOKEN is on)
SESSION_TTL_HOURS=8
